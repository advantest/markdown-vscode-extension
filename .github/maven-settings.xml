<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven settings for the CI: the token of the workflow run reads the distribution of markdown-ls from GitHub
     Packages. The workflow passes GITHUB_TOKEN as an environment variable. -->
<settings>
	<servers>
		<server>
			<id>github-packages-markdown-ls</id>
			<username>${env.GITHUB_ACTOR}</username>
			<password>${env.GITHUB_TOKEN}</password>
		</server>
	</servers>
</settings>
