# Dependencies, installed by npm from package-lock.json
node_modules/

# Compiled and bundled output
out/
dist/

# Packaged extensions
*.vsix

# VS Code instances and downloads of the extension tests
.vscode-test/

# Test coverage
coverage/

# Logs
*.log

# The language server, fetched by "npm run fetch-server" and bundled with the extension
server/

# The third-party notices, written by "npm run notices" and packaged with the extension
ThirdPartyNotices.txt

# The SBOM, written by "npm run sbom" and packaged with the extension
bom.json

# Environment variables of this machine, read by the tests
.env
