{
  "name": "markdown-support",
  "displayName": "Markdown Support",
  "description": "Validation of Markdown documents, provided by the language server markdown-ls.",
  "version": "1.0.0-alpha",
  "publisher": "advantest",
  "license": "BSD-3-Clause",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "markdown",
    "language server",
    "validation"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "markdownSupport": {
    "defaultServer": {
      "groupId": "com.advantest.markdown",
      "artifactId": "markdown-ls",
      "version": "1.0.0-SNAPSHOT"
    },
    "declaredServer": {
      "minimumVersion": "1.0"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "markdownSupport.preview.open",
        "title": "Open Preview",
        "category": "Markdown Support",
        "icon": "$(open-preview)"
      },
      {
        "command": "markdownSupport.preview.openToSide",
        "title": "Open Preview to the Side",
        "category": "Markdown Support",
        "icon": {
          "light": "images/preview-to-side-light.svg",
          "dark": "images/preview-to-side-dark.svg"
        }
      },
      {
        "command": "markdownSupport.preview.showElement",
        "title": "Show in Preview",
        "category": "Markdown Support"
      },
      {
        "command": "markdownSupport.environment.showPlantUml",
        "title": "Show PlantUML and Graphviz",
        "category": "Markdown Support"
      },
      {
        "command": "markdownSupport.environment.showDependencies",
        "title": "Show Dependencies",
        "category": "Markdown Support"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "markdownSupport.preview.open",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownSupport.preview.openToSide",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownSupport.preview.showElement",
          "when": "editorLangId == markdown"
        }
      ],
      "editor/title": [
        {
          "command": "markdownSupport.preview.openToSide",
          "alt": "markdownSupport.preview.open",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "markdownSupport.preview.showElement",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownSupport.preview.open",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Support",
      "properties": {
        "markdownSupport.java.home": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "pattern": "^(?![\\s\\S]*(?:[\\\\/][bB][iI][nN](?:[\\\\/][jJ][aA][vV][aA](?:\\.[eE][xX][eE])?)?[\\\\/]?|\\.[eE][xX][eE])\\s*$)",
          "patternErrorMessage": "Set the folder of the Java installation, the one that contains bin, not the Java executable or its bin folder.",
          "markdownDescription": "The folder of the Java installation that runs the language server, a JDK or JRE 21 or newer, i.e. the folder that contains `bin/java`, e.g. `/usr/lib/jvm/java-21` or `C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.5.11-hotspot`. If empty, `JAVA_HOME` and then the `PATH` are searched for a Java."
        },
        "markdownSupport.plantUml.dotExecutable": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The path of Graphviz's `dot` executable, which PlantUML draws most diagrams with, e.g. `/usr/bin/dot` or `C:\\Program Files\\Graphviz\\bin\\dot.exe`. If empty, the environment variable `GRAPHVIZ_DOT` and then the usual places are searched.\n\nWhat the language server runs with: [PlantUML and Graphviz](command:markdownSupport.environment.showPlantUml), [Dependencies](command:markdownSupport.environment.showDependencies)."
        },
        "markdownSupport.preview.openWebLinksIn": {
          "type": "string",
          "enum": [
            "integratedBrowser",
            "systemBrowser"
          ],
          "enumDescriptions": [
            "VS Code's integrated browser; the system browser where VS Code has none.",
            "The browser of the operating system."
          ],
          "default": "integratedBrowser",
          "scope": "window",
          "description": "Where a web address that is clicked in the preview opens."
        },
        "markdownSupport.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Traces the communication between VS Code and the language server in the output of the extension."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p src/webview",
    "lint": "eslint",
    "compile": "npm run check && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "compile-tests": "tsc",
    "prepare": "npm run compile && npm run compile-tests",
    "pretest": "npm run compile && npm run compile-tests && npm run lint",
    "test": "npm run test:unit && npm run test:integration",
    "posttest": "npm run coverage",
    "test:unit": "c8 mocha",
    "test:integration": "vscode-test --coverage --coverage-reporter json --coverage-output coverage/integration",
    "coverage": "node scripts/coverage.mjs",
    "fetch-server": "esbuild scripts/fetchServer.ts --bundle --platform=node --target=node20 --outfile=out/fetchServer.js --log-level=warning && node out/fetchServer.js",
    "notices": "esbuild scripts/thirdPartyNotices.ts --bundle --platform=node --target=node20 --outfile=out/thirdPartyNotices.js --log-level=warning && node out/thirdPartyNotices.js",
    "sbom": "cyclonedx-npm --omit dev --spec-version 1.6 --output-format JSON --output-file out/npm-bom.json && esbuild scripts/sbom.ts --bundle --platform=node --target=node20 --outfile=out/sbom.js --log-level=warning && node out/sbom.js",
    "vscode:prepublish": "npm run check && npm run fetch-server && node esbuild.mjs --production && npm run notices && npm run sbom",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "overrides": {
    "@vscode/test-cli": {
      "mocha": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.1.4"
      }
    },
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^7.0.0",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.91.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "mocha": "^12.0.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "11.10.0",
    "mathjax": "3.2.2",
    "vscode-languageclient": "^11.0.0"
  }
}
