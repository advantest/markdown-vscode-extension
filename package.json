{
  "name": "markdown-support",
  "displayName": "Markdown Support",
  "description": "Validation of Markdown documents, provided by the language server markdown-ls.",
  "version": "0.0.1",
  "publisher": "advantest",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "markdown",
    "language server",
    "validation"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownSupport.preview.open",
        "title": "Open Preview",
        "category": "Markdown Support",
        "icon": "$(open-preview)"
      },
      {
        "command": "markdownSupport.preview.openToSide",
        "title": "Open Preview to the Side",
        "category": "Markdown Support",
        "icon": "$(open-preview)"
      },
      {
        "command": "markdownSupport.preview.showElement",
        "title": "Show in Preview",
        "category": "Markdown Support"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "markdownSupport.preview.open",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownSupport.preview.openToSide",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownSupport.preview.showElement",
          "when": "editorLangId == markdown"
        }
      ],
      "editor/title": [
        {
          "command": "markdownSupport.preview.openToSide",
          "alt": "markdownSupport.preview.open",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "markdownSupport.preview.showElement",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownSupport.preview.open",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Support",
      "properties": {
        "markdownSupport.java.home": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "pattern": "^(?![\\s\\S]*(?:[\\\\/][bB][iI][nN](?:[\\\\/][jJ][aA][vV][aA](?:\\.[eE][xX][eE])?)?[\\\\/]?|\\.[eE][xX][eE])\\s*$)",
          "patternErrorMessage": "Set the folder of the Java installation, the one that contains bin, not the Java executable or its bin folder.",
          "markdownDescription": "The folder of the Java installation that runs the language server, a JDK or JRE 21 or newer, i.e. the folder that contains `bin/java`, e.g. `/usr/lib/jvm/java-21` or `C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.5.11-hotspot`. If empty, `JAVA_HOME` and then the `PATH` are searched for a Java."
        },
        "markdownSupport.server.jar": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "pattern": "^\\s*$|\\.[jJ][aA][rR]\\s*$",
          "patternErrorMessage": "Set the path of a JAR file, ending in .jar, e.g. /opt/markdown-ls/markdown-ls.jar.",
          "markdownDescription": "The JAR of the language server `markdown-ls`, e.g. `/opt/markdown-ls/markdown-ls.jar`. The server is started with `java -jar`, so its manifest names the main class and the libraries it needs; take the JAR of the unpacked distribution, which has its libraries next to it."
        },
        "markdownSupport.server.vmArgs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\s*[-@]",
            "patternErrorMessage": "A Java VM option starts with \"-\", e.g. -Xmx1g, or names an argument file with \"@\"."
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Options for the Java VM running the language server, one per item, each starting with `-`, e.g. `-Xmx1g`, or `@` and the path of an argument file."
        },
        "markdownSupport.preview.openWebLinksIn": {
          "type": "string",
          "enum": [
            "integratedBrowser",
            "systemBrowser"
          ],
          "enumDescriptions": [
            "VS Code's integrated browser; the system browser where VS Code has none.",
            "The browser of the operating system."
          ],
          "default": "integratedBrowser",
          "scope": "window",
          "description": "Where a web address that is clicked in the preview opens."
        },
        "markdownSupport.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Traces the communication between VS Code and the language server in the output of the extension."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p src/webview",
    "lint": "eslint",
    "compile": "npm run check && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "compile-tests": "tsc",
    "pretest": "npm run compile && npm run compile-tests && npm run lint",
    "test": "npm run test:unit && npm run test:integration",
    "posttest": "npm run coverage",
    "test:unit": "c8 mocha",
    "test:integration": "vscode-test --coverage --coverage-reporter json --coverage-output coverage/integration",
    "coverage": "node scripts/coverage.mjs",
    "vscode:prepublish": "npm run check && node esbuild.mjs --production",
    "package": "vsce package --no-dependencies --skip-license --allow-missing-repository"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.91.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "mocha": "^12.0.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "11.10.0",
    "mathjax": "3.2.2",
    "vscode-languageclient": "^11.0.0"
  }
}
