{
  "name": "markdown-support",
  "displayName": "Markdown Support",
  "description": "Validation of Markdown documents, provided by the language server markdown-ls.",
  "version": "0.0.1",
  "publisher": "advantest",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "markdown",
    "language server",
    "validation"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint",
    "compile": "npm run check && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run check && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.91.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "mocha": "^12.0.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
